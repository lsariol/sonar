# Local development only: copy to .env (gitignored, never committed).
# Compose fills the ${...} values in docker-compose.yml from it, the way Lighthouse
# fills them from Cove in prod.

# sparkdb-dev on this PC, as containers reach it. The roles come from
# scripts/db/setup.sql, run once on sparkdb-dev.
SONAR_DATABASE_URL=postgres://sonar_app:CHANGE_ME@host.docker.internal:5000/sonar_db
SONAR_DATABASE_MIGRATOR_URL=postgres://sonar_migrator:CHANGE_ME@host.docker.internal:5000/sonar_db
SONAR_DATABASE_READER_URL=postgres://sonar_reader:CHANGE_ME@host.docker.internal:5000/sonar_db

# A dev-only API token: 32 or more random characters (e.g. openssl rand -hex 32).
SHARED_SONAR_MOBASITY_WEB_TOKEN=

# The time zone the CLI shows times in.
TZ=America/Toronto
