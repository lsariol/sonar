# Local development only: copy to .env, which compose reads for the ${...} values.

# Postgres, as the containers reach it; scripts/db/setup.sql creates the roles.
SONAR_DATABASE_URL=postgres://sonar_app:CHANGE_ME@host.docker.internal:5432/sonar_db
SONAR_DATABASE_MIGRATOR_URL=postgres://sonar_migrator:CHANGE_ME@host.docker.internal:5432/sonar_db
SONAR_DATABASE_READER_URL=postgres://sonar_reader:CHANGE_ME@host.docker.internal:5432/sonar_db
SONAR_DATABASE_MONITOR_URL=postgres://sonar_monitor:CHANGE_ME@host.docker.internal:5432/sonar_db

# A Cloudflare API token with Zone Read and Analytics Read; a wrong one only shows as an error.
SONAR_CLOUDFLARE_TOKEN=

# One API token per consumer, 32 or more random characters each (openssl rand -hex 32).
SHARED_SONAR_MOBASITY_WEB_TOKEN=
SHARED_SONAR_VISTA_TOKEN=

# The time zone the CLI shows times in.
TZ=America/Toronto
